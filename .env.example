# ══════════════════════════════════════════════════════════════
#  نموذج المتغيّرات — لا يحتوي قيمًا حقيقية
#
#  ⚠ القيم هنا نصوص توضيحية فقط (REPLACE_ME). لو أي أداة نسختها
#    كما هي إلى بيئة تشغيل، التطبيق هيقع فورًا — وده مقصود، أحسن
#    من إنه يشتغل بقيم غلط ويفشل بشكل غامض.
#
#  انسخ الملف ده إلى .env.local واملأ القيم من Supabase.
# ══════════════════════════════════════════════════════════════

# ─── قاعدة البيانات (Supabase) ────────────────────────────────
# Supabase → Connect → Connection String → Transaction pooler (منفذ 6543)
DATABASE_URL="REPLACE_ME"
# نفس الرابط بمنفذ 5432 (Session pooler) — للهجرات فقط
DIRECT_URL="REPLACE_ME"

# ─── Supabase (التخزين والصور) ────────────────────────────────
# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL="REPLACE_ME"
# Supabase → Project Settings → API Keys → service_role (سرّي تمامًا)
SUPABASE_SERVICE_ROLE_KEY="REPLACE_ME"

# ─── المنصة ───────────────────────────────────────────────────
# النطاق الجذر بدون https:// ومن غير / في آخره ومن غير www.
# منه تتفرّع نطاقات المتاجر: <store>.zawyaeg.site
NEXT_PUBLIC_ROOT_DOMAIN="zawyaeg.site"
NEXT_PUBLIC_APP_NAME="زاوية"

# المضيف اللي الموقع بيرد عليه فعلًا، بالبروتوكول.
#
# لازم يبقى اللي بيرد لا اللي بيحوّل: الروابط اللي بتتلزق عند بوابات
# الدفع وشركات الشحن بتتبني منه، والتحويل بيضيّع حمولة POST — يعني
# تأكيد دفع بيتبعت وما بيوصلش.
# لو الموقع على www سيبها كده، ولو على الجذر شيل الـwww.
NEXT_PUBLIC_SITE_URL="https://www.zawyaeg.site"

# النطاقات الفرعية للمتاجر: on / off
# off  → روابط بالمسار (/s/<slug>) — قبل ضبط سجل wildcard
# on   → نطاق فرعي لكل متجر — بعد إضافة *.النطاق في Vercel
NEXT_PUBLIC_SUBDOMAINS="off"

# ─── الأسرار ──────────────────────────────────────────────────
# ولّد كل واحد بأمر: openssl rand -base64 32
#
# ⚠ ENCRYPTION_KEY يفكّ تشفير مفاتيح بوابات الدفع والشحن المخزّنة.
#   تغييره بعد التشغيل = كل المفاتيح المحفوظة تبقى غير قابلة للقراءة.
# ⚠ AUTH_SECRET تغييره = خروج كل المستخدمين من حساباتهم.
AUTH_SECRET="REPLACE_ME"
ENCRYPTION_KEY="REPLACE_ME"
CRON_SECRET="REPLACE_ME"

# ─── البريد ───────────────────────────────────────────────────
# المزوّد الافتراضي Resend. القيم المدعومة: resend أو postmark أو brevo.
EMAIL_PROVIDER="resend"
# Postmark → Servers → API Tokens → Server API Token. يُستخدم فقط حين EMAIL_PROVIDER=postmark.
POSTMARK_SERVER_TOKEN=""
# اختياري: اسم Message Stream في Postmark. الافتراضي outbound.
POSTMARK_MESSAGE_STREAM="outbound"

# Brevo → Transactional → API Settings → أنشئ API key.
# يُستخدم فقط حين EMAIL_PROVIDER=brevo، ولا يوضع في المتصفح أو في Git.
BREVO_API_KEY=""

# Resend (للتوافق مع الإرسال القديم فقط)
# لازم لرموز تأكيد الحساب. لو فاضي، يُؤكَّد الحساب تلقائيًا
# بدل أن يُقفل الباب على صاحبه — والتحقق يصير إلزاميًا فور ضبطه.
# resend.com → API Keys
RESEND_API_KEY=""
# لازم يكون على نطاق موثَّق في Resend، مثال: "زاوية <no-reply@zawyaeg.site>"
EMAIL_FROM=""
# من Resend → Webhooks. هذا سرّ توقيع الأحداث وليس API key، ولا يُضاف للمتصفح.
RESEND_WEBHOOK_SECRET=""
