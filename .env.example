# ─── قاعدة البيانات (Supabase) ────────────────────────────────
# من: Supabase → Project Settings → Database → Connection string → Transaction pooler
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"
# نفس الرابط لكن بمنفذ 5432 (Session) — يُستخدم للـmigrations فقط
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ─── Supabase (التخزين والصور) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ─── المنصة ───────────────────────────────────────────────────
# النطاق الجذر — منه تتفرّع نطاقات المتاجر: <store>.zawya.cc
NEXT_PUBLIC_ROOT_DOMAIN="zawya.cc"
NEXT_PUBLIC_APP_NAME="زاوية"

# مفتاح توقيع الجلسات — ولّده بـ: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"
# مفتاح تشفير أسرار التكاملات المخزّنة في قاعدة البيانات (32 بايت base64)
ENCRYPTION_KEY="change-me-in-production"

# سرّ حماية مسارات الـcron
CRON_SECRET="change-me-in-production"

# النطاقات الفرعية للمتاجر: on / off
# اتركها فارغة ليقرّر النظام تلقائيًا (تنطفئ على vercel.app وlocalhost).
# شغّلها "on" بعد شراء الدومين وإضافة سجل wildcard.
NEXT_PUBLIC_SUBDOMAINS=""
