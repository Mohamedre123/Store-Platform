        <item name="android:statusBarColor">@color/zawya_background</item>
        <item name="android:navigationBarColor">@color/zawya_background</item>
        <item name="android:windowLightStatusBar">@bool/zawya_light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/zawya_light_bars</item>
        <item name="colorPrimary">@color/zawya_primary</item>
        <item name="colorAccent">@color/zawya_primary</item>
    </style>
